diag2 <- function(x){
# transform the numeric into diag matrix
if(length(x)>1){
return(diag(x))
}else{
return(as.matrix(x))
}
}
tmp = matrix(c(1:9), ncol = 3)
tmp
diag2(tmp)
length(tmp)
diag(tmp)
as.matrix(1)
as.matrix(2)
tr(tmp)
trace(tmp)
